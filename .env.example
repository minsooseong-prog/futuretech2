# Neon pooled connection string. Never use NEXT_PUBLIC_ for database credentials.
DATABASE_URL=
# Direct connection for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=future-tech-private
# Optional public project values; this app uses server-only Storage access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Exact public origin, no trailing slash. Use http://localhost:3000 locally.
APP_URL=http://localhost:3000
# Optional class invitation code. Set before public launch to restrict enrollment.
REGISTRATION_CODE=
# Override the specification's initial passwords before initial seeding if desired.
INITIAL_ADMIN_PASSWORD=NNNNN
INITIAL_NOTICE_PASSWORD=00000
INITIAL_CALENDAR_PASSWORD=00000
# For authenticated Vercel cron / storage cleanup endpoint
CRON_SECRET=
